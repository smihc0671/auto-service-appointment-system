# Copy this file as .env.e2e.local in the project root.
# Never commit .env.e2e.local to Git.

# Enables live Firebase appointment creation/deletion tests.
E2E_LIVE=1

# Test/admin account already configured in Firebase Authentication.
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=YOUR_PASSWORD_HERE

# Set E2E_LIVE=0 to disable writes to the live Firebase database.
# UI and pure logic tests can still be executed.